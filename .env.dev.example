# Local development only. Copy to .env.dev.
DEV_FRONTEND_PORT=5173
DEV_API_PORT=8000
DEV_DB_PORT=5433
DEV_REDIS_PORT=6380
DEV_KEYCLOAK_PORT=8080
DEV_KEYCLOAK_DB_PORT=5434
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Application settings are passed to api, worker and scheduler.
APP_NAME=rtk-smart-warehouse
API_V1_PREFIX=/api/v1
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=dev-warehouse
DB_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
REDIS_DSN=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Keycloak has its own database.
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=dev-keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-admin

# Created automatically by dev-init. These credentials are for local development.
KEYCLOAK_URL=http://keycloak:8080/
KEYCLOAK_REALM=warehouse
KEYCLOAK_CLIENT_ID=smart-warehouse
KEYCLOAK_CLIENT_SECRET=dev-client-secret
# The current backend uses a realm administrator username/password.
KEYCLOAK_ADMIN_USERNAME=dev-service-admin
KEYCLOAK_ADMIN_PASSWORD=dev-service-password
DEV_LOGIN_EMAIL=admin@example.com
DEV_LOGIN_PASSWORD=dev-admin-123

DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=8
DB_POOL_RECYCLE_SEC=120
DB_POOL_PRE_PING=true
USE_REDIS_COORD=1
SCHEDULER_RUN_ONCE=0
