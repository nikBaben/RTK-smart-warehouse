# Copy to .env.prod. Set real domains, image tags and unique secrets.
BACKEND_IMAGE=rtk-smart-warehouse-backend:1.0.0
FRONTEND_IMAGE=rtk-smart-warehouse-frontend:1.0.0
APP_DOMAIN=warehouse.example.com
KEYCLOAK_DOMAIN=auth.example.com
CORS_ORIGINS=["https://warehouse.example.com"]
UVICORN_WORKERS=2

# Application settings are passed to api, worker and scheduler.
APP_NAME=rtk-smart-warehouse
API_V1_PREFIX=/api/v1
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=replace-with-db-password
DB_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
REDIS_DSN=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Keycloak has its own database.
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=replace-with-keycloak-db-password
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-bootstrap-password

# Create/import this realm and client before using authentication.
KEYCLOAK_URL=http://keycloak:8080/
KEYCLOAK_REALM=warehouse
KEYCLOAK_CLIENT_ID=smart-warehouse
KEYCLOAK_CLIENT_SECRET=replace-with-client-secret
# The current backend uses a realm administrator username/password.
KEYCLOAK_ADMIN_USERNAME=replace-with-realm-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-realm-admin-password

DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=8
DB_POOL_RECYCLE_SEC=120
DB_POOL_PRE_PING=true
USE_REDIS_COORD=1
SCHEDULER_RUN_ONCE=0
